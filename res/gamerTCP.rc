#include <windows.h>

#include "resource.h"

// The multi-size ZGT icon shows in Explorer, the title bar and the taskbar.
IDI_APP_ICON ICON "gamerTCP.ico"

// The manifest is embedded by MSVC through this resource. The MinGW build
// instead compiles manifest_only.rc into default-manifest.o (see build.bat),
// because GCC's specs otherwise inject a second, conflicting manifest.

#ifdef GAMERTCP_EMBED_MANIFEST
1 24 "gamerTCP.manifest"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 4,2,1,0
 PRODUCTVERSION 4,2,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "GamerTCP"
            VALUE "FileDescription", "GamerTCP 4 - Windows 10/11 network optimization toolkit"
            VALUE "FileVersion", "4.2.1.0"
            VALUE "InternalName", "GamerTCP"
            VALUE "OriginalFilename", "GamerTCP.exe"
            VALUE "ProductName", "GamerTCP 4"
            VALUE "ProductVersion", "4.2.1.0"
            VALUE "LegalCopyright", "BSD 3-Clause. Tweak set derived from GameTCP3 (c) 2022 Charles McDonald."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
